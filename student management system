import json
import os

DATA_FILE = "students.json"


# ---------------------------------------------------------
# Load student data
# ---------------------------------------------------------
def load_data():
    if os.path.exists(DATA_FILE):
        try:
            with open(DATA_FILE, "r") as file:
                return json.load(file)
        except (json.JSONDecodeError, OSError):
            return {}
    return {}


# ---------------------------------------------------------
# Save student data
# ---------------------------------------------------------
def save_data(students):
    with open(DATA_FILE, "w") as file:
        json.dump(students, file, indent=4)


# ---------------------------------------------------------
# Calculate grade
# ---------------------------------------------------------
def calculate_grade(marks):
    if marks >= 90:
        return "A+"
    elif marks >= 75:
        return "A"
    elif marks >= 60:
        return "B"
    elif marks >= 40:
        return "C"
    else:
        return "Fail"


# ---------------------------------------------------------
# Add student
# ---------------------------------------------------------
def add_student(students):
    print("\n========== ADD STUDENT ==========")

    roll_no = input("Enter Roll No: ").strip()

    if not roll_no:
        print("❌ Roll No cannot be empty.")
        return

    if roll_no in students:
        print("❌ Student with this Roll No already exists.")
        return

    name = input("Enter Student Name: ").strip()

    if not name:
        print("❌ Student name cannot be empty.")
        return

    try:
        marks = float(input("Enter Marks (0-100): "))

        if marks < 0 or marks > 100:
            print("❌ Marks must be between 0 and 100.")
            return

    except ValueError:
        print("❌ Please enter valid numeric marks.")
        return

    students[roll_no] = {
        "name": name,
        "marks": marks,
        "grade": calculate_grade(marks)
    }

    save_data(students)

    print("\n✅ Student added successfully!")
    print("Roll No :", roll_no)
    print("Name    :", name)
    print("Marks   :", marks)
    print("Grade   :", calculate_grade(marks))


# ---------------------------------------------------------
# View all students
# ---------------------------------------------------------
def view_students(students):
    print("\n========== ALL STUDENTS ==========")

    if not students:
        print("⚠️ No student records found.")
        return

    print("-" * 60)
    print(f"{'Roll No':<12}{'Name':<20}{'Marks':<12}{'Grade':<10}")
    print("-" * 60)

    for roll_no, info in students.items():
        print(
            f"{roll_no:<12}"
            f"{info['name']:<20}"
            f"{info['marks']:<12.2f}"
            f"{info['grade']:<10}"
        )

    print("-" * 60)


# ---------------------------------------------------------
# Search student
# ---------------------------------------------------------
def search_student(students):
    print("\n========== SEARCH STUDENT ==========")

    roll_no = input("Enter Roll No: ").strip()

    if roll_no in students:
        info = students[roll_no]

        print("\n✅ Student Found")
        print("-" * 35)
        print("Roll No :", roll_no)
        print("Name    :", info["name"])
        print("Marks   :", info["marks"])
        print("Grade   :", info["grade"])
        print("-" * 35)

    else:
        print("❌ Student not found.")


# ---------------------------------------------------------
# Update marks
# ---------------------------------------------------------
def update_marks(students):
    print("\n========== UPDATE MARKS ==========")

    roll_no = input("Enter Roll No: ").strip()

    if roll_no not in students:
        print("❌ Student not found.")
        return

    try:
        new_marks = float(input("Enter New Marks (0-100): "))

        if new_marks < 0 or new_marks > 100:
            print("❌ Marks must be between 0 and 100.")
            return

    except ValueError:
        print("❌ Please enter valid numeric marks.")
        return

    students[roll_no]["marks"] = new_marks
    students[roll_no]["grade"] = calculate_grade(new_marks)

    save_data(students)

    print("✅ Marks updated successfully!")
    print("New Marks :", new_marks)
    print("New Grade :", calculate_grade(new_marks))


# ---------------------------------------------------------
# Delete student
# ---------------------------------------------------------
def delete_student(students):
    print("\n========== DELETE STUDENT ==========")

    roll_no = input("Enter Roll No: ").strip()

    if roll_no not in students:
        print("❌ Student not found.")
        return

    student_name = students[roll_no]["name"]

    confirm = input(
        f"Are you sure you want to delete {student_name}? (y/n): "
    ).lower()

    if confirm == "y":
        del students[roll_no]
        save_data(students)

        print("🗑️ Student deleted successfully!")

    else:
        print("❌ Delete operation cancelled.")


# ---------------------------------------------------------
# Class average
# ---------------------------------------------------------
def class_average(students):
    print("\n========== CLASS AVERAGE ==========")

    if not students:
        print("⚠️ No student records available.")
        return

    total = 0

    for info in students.values():
        total += info["marks"]

    average = total / len(students)

    print(f"📊 Number of Students : {len(students)}")
    print(f"📊 Class Average      : {average:.2f}")


# ---------------------------------------------------------
# Grade statistics
# ---------------------------------------------------------
def grade_statistics(students):
    print("\n========== GRADE STATISTICS ==========")

    if not students:
        print("⚠️ No student records available.")
        return

    grade_count = {
        "A+": 0,
        "A": 0,
        "B": 0,
        "C": 0,
        "Fail": 0
    }

    for info in students.values():
        grade = info["grade"]
        grade_count[grade] += 1

    for grade, count in grade_count.items():
        print(f"{grade:<6}: {count} student(s)")


# ---------------------------------------------------------
# Main menu
# ---------------------------------------------------------
def main():

    students = load_data()

    while True:

        print("\n")
        print("=" * 50)
        print("       STUDENT MANAGEMENT SYSTEM")
        print("=" * 50)

        print("1. Add Student")
        print("2. View All Students")
        print("3. Search Student")
        print("4. Update Marks")
        print("5. Delete Student")
        print("6. Class Average")
        print("7. Grade Statistics")
        print("8. Exit")

        print("=" * 50)

        choice = input("Enter your choice (1-8): ").strip()

        if choice == "1":
            add_student(students)

        elif choice == "2":
            view_students(students)

        elif choice == "3":
            search_student(students)

        elif choice == "4":
            update_marks(students)

        elif choice == "5":
            delete_student(students)

        elif choice == "6":
            class_average(students)

        elif choice == "7":
            grade_statistics(students)

        elif choice == "8":
            print("\nThank you for using Student Management System!")
            print("Goodbye 👋")
            break

        else:
            print("❌ Invalid choice. Please enter 1-8.")


# ---------------------------------------------------------
# Start program
# ---------------------------------------------------------
if __name__ == "__main__":
    main()
